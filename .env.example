# Optional: copy to .env in the repository root. No secrets are required.
SMALLTV_HOST=127.0.0.1
SMALLTV_PORT=8000
SMALLTV_LOG_LEVEL=info
SMALLTV_DB_PATH=data/smalltv.sqlite3
# False only for local HTTP. Use true with future HTTPS hosting.
SMALLTV_COOKIE_SECURE=false
SMALLTV_SESSION_TTL_SECONDS=43200
# Agent heartbeat freshness (offline must exceed stale).
SMALLTV_AGENT_STALE_SECONDS=30
SMALLTV_AGENT_OFFLINE_SECONDS=90
# Device heartbeat freshness (offline must exceed stale).
SMALLTV_DEVICE_STALE_SECONDS=30
SMALLTV_DEVICE_OFFLINE_SECONDS=90
# Weather cache duration and outbound request timeout (Open-Meteo; no API key).
SMALLTV_WEATHER_CACHE_SECONDS=900
SMALLTV_WEATHER_TIMEOUT_SECONDS=4
# Optional Storm Bot token. Set only in your local .env, never in Git or chat.
SMALLTV_TELEGRAM_BOT_TOKEN=
